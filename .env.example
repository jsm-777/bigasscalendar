# Copy to .env for local development; set the same names in Vercel → Settings → Environment
# Variables for production. Never commit real values. See docs/GOOGLE_SETUP.md.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string used to encrypt the sign-in cookie (openssl rand -base64 32)
SESSION_SECRET=
# Your site address, no trailing slash. Local: http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Only these Google accounts may sign in (comma separated). Recommended.
ALLOWED_EMAILS=

PORT=8787
