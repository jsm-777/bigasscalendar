# Copy to .env for local development, and set the same names in Vercel → Settings →
# Environment Variables for production. Never commit real values.

# Postgres connection. Production: your Supabase "Transaction pooler" URI (port 6543).
# Leave empty locally to use the embedded PGlite database stored in ./data/pglite.
DATABASE_URL=

# Protects /api/cron (Vercel sends it automatically as a Bearer token). Any long random string.
CRON_SECRET=

# Set to "true" only while creating the first account(s). Afterwards people join by invitation.
ALLOW_OPEN_SIGNUP=true

# Public origin used in invitation links, e.g. https://your-app.vercel.app
APP_ORIGIN=http://localhost:5173

# Vercel only: how often reminders are delivered in the background. Hobby allows once a day
# ("0 13 * * *"); Pro allows every minute ("* * * * *"). See README.
CRON_SCHEDULE=

# Web Push (VAPID). Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional in-app planning assistant (server-side only; never exposed to the browser).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Local server port
PORT=8787
